rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isHouseholdMember(householdId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    // --- 1. Espacio Privado ("Mi Billetera") ---
    // Aislamiento absoluto: sólo el propio usuario puede leer y escribir
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- 2. Espacio Colaborativo ("El Hogar") ---
    // Acceso restringido a miembros activos del hogar
    match /households/{householdId} {
      // Creación: cualquier usuario autenticado puede crear un hogar nuevo
      allow create: if isAuthenticated();
      // Lectura y actualización: sólo miembros verificados
      allow read, update: if isHouseholdMember(householdId);
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;

      // Subcolección de Miembros
      match /members/{memberId} {
        allow read: if isHouseholdMember(householdId);
        // Permitir unirse o ser administrado por un miembro existente
        allow write: if isAuthenticated() && (request.auth.uid == memberId || isHouseholdMember(householdId));
      }

      // Gastos, Cuotas, Pagos fijos, Lista de compras y Feed colaborativo
      match /{subcollection}/{docId} {
        allow read, write: if isHouseholdMember(householdId);
      }
    }
  }
}
